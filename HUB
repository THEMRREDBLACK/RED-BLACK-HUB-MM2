local loadingLabel = Instance.new("TextLabel", centerContent)
loadingLabel.Size = UDim2.new(1, 0, 0, 40)
loadingLabel.Position = UDim2.new(0, 0, 0, 340)
loadingLabel.BackgroundTransparency = 1
loadingLabel.Font = Enum.Font.GothamMedium
loadingLabel.TextSize = 26
loadingLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
loadingLabel.ZIndex = 6
loadingLabel.Text = LOADING_TEXTS[1]

local loaderBg = Instance.new("Frame", centerContent)
loaderBg.Size = UDim2.new(0, 650, 0, 20)
loaderBg.Position = UDim2.new(0.5, 0, 0.82, 0)
loaderBg.AnchorPoint = Vector2.new(0.5, 0.5)
loaderBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
loaderBg.BorderSizePixel = 0
loaderBg.ZIndex = 6
Instance.new("UICorner", loaderBg).CornerRadius = UDim.new(1, 0)

local loaderBgStroke = Instance.new("UIStroke", loaderBg)
loaderBgStroke.Color = Color3.fromRGB(80, 0, 0)
loaderBgStroke.Thickness = 2

local loaderFill = Instance.new("Frame", loaderBg)
loaderFill.Size = UDim2.new(0, 0, 1, 0)
loaderFill.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
loaderFill.BorderSizePixel = 0
loaderFill.ZIndex = 7
Instance.new("UICorner", loaderFill).CornerRadius = UDim.new(1, 0)

local fillGradient = Instance.new("UIGradient", loaderFill)
fillGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 0, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 80))
})

local s = Instance.new("Sound", SoundService)
s.SoundId = "rbxassetid://9118828569"
s.Volume = 0.6
s:Play()

local steps = 100
for i = 1, steps do
    local progress = i / steps
    TweenService:Create(loaderFill, TweenInfo.new(LOAD_TIME / steps, Enum.EasingStyle.Linear), {
        Size = UDim2.new(progress, 0, 1, 0)
    }):Play()
    
    if i % 33 == 0 then
        local textIndex = math.clamp(math.ceil(i / 33), 1, #LOADING_TEXTS)
        loadingLabel.Text = LOADING_TEXTS[textIndex]
    end
    
    task.wait(LOAD_TIME / steps)
end

TweenService:Create(centerContent, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
    Size = UDim2.new(0, 0, 0, 0)
}):Play()

local fadeScreen = Instance.new("Frame", gui)
fadeScreen.Size = UDim2.new(1, 0, 1, 0)
fadeScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
fadeScreen.BackgroundTransparency = 1
fadeScreen.ZIndex = 10

TweenService:Create(fadeScreen, TweenInfo.new(1), {BackgroundTransparency = 0}):Play()
TweenService:Create(blur, TweenInfo.new(1), {Size = 0}):Play()

task.wait(1.1)
gui:Destroy()
blur:Destroy()

-- Executa o script do MM2 logo após o término do loader
local success, err = pcall(function()
    loadstring(game:HttpGet(MM2_SCRIPT_URL))()
end)

if not success then
    warn("Failed to execute MM2 script: " .. tostring(err))
    notifyRoblox("Error", "Failed to load MM2 script.", 8)
end
